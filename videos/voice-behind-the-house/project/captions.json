[
  {
    "text": "At midnight, a voice called",
    "start": 0.35,
    "end": 2.15
  },
  {
    "text": "from the banana trees behind our",
    "start": 2.15,
    "end": 3.85
  },
  {
    "text": "house.",
    "start": 3.85,
    "end": 4.8
  },
  {
    "text": "It sounded exactly like my mother",
    "start": 5.933333333333333,
    "end": 8.258333333333333
  },
  {
    "text": ".",
    "start": 8.258333333333333,
    "end": 8.433333333333334
  },
  {
    "text": "\"Come outside, honey.",
    "start": 9.508333333333333,
    "end": 10.720833333333331
  },
  {
    "text": "Bring the lamp.\"",
    "start": 10.720833333333331,
    "end": 12.083333333333332
  },
  {
    "text": "I picked it up. She",
    "start": 13.183333333333332,
    "end": 14.320833333333333
  },
  {
    "text": "sounded so close.",
    "start": 14.320833333333333,
    "end": 15.983333333333333
  },
  {
    "text": "I walked to the back door",
    "start": 17.125,
    "end": 18.275
  },
  {
    "text": "without answering.",
    "start": 18.275,
    "end": 19.7
  },
  {
    "text": "My fingers were already touching the",
    "start": 20.833333333333332,
    "end": 22.633333333333333
  },
  {
    "text": "lock.",
    "start": 22.633333333333333,
    "end": 23.458333333333332
  },
  {
    "text": "Then my phone started ringing.",
    "start": 24.583333333333332,
    "end": 26.758333333333333
  },
  {
    "text": "It was Mom. She was",
    "start": 27.891666666666666,
    "end": 29.141666666666666
  },
  {
    "text": "still at the hospital.",
    "start": 29.141666666666666,
    "end": 30.741666666666664
  },
  {
    "text": "\"Listen carefully. If you",
    "start": 31.849999999999998,
    "end": 33.449999999999996
  },
  {
    "text": "hear me outside tonight, do",
    "start": 33.449999999999996,
    "end": 34.8625
  },
  {
    "text": "not answer.\"",
    "start": 34.8625,
    "end": 36.074999999999996
  },
  {
    "text": "I pulled my hand away from",
    "start": 37.18333333333333,
    "end": 38.59583333333333
  },
  {
    "text": "the lock.",
    "start": 38.59583333333333,
    "end": 39.55833333333333
  },
  {
    "text": "Something pressed against the other side",
    "start": 40.70833333333333,
    "end": 42.72083333333333
  },
  {
    "text": "of the door.",
    "start": 42.72083333333333,
    "end": 43.80833333333333
  },
  {
    "text": "Then her voice whispered, \"",
    "start": 44.95833333333333,
    "end": 46.43333333333333
  },
  {
    "text": "I know you are standing there",
    "start": 46.43333333333333,
    "end": 48.133333333333326
  },
  {
    "text": ".\"",
    "start": 48.133333333333326,
    "end": 48.33333333333333
  }
]