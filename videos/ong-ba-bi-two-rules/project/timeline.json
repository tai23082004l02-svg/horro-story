[
  {
    "id": 1,
    "start": 0,
    "end": 5.75,
    "text": "A sack is hanging outside your bedroom. Your front gate is still locked.",
    "image": "project/assets/scene-01.png"
  },
  {
    "id": 2,
    "start": 5.75,
    "end": 10.25,
    "text": "In Vietnam, they tell children about Ong Ba Bi.",
    "image": "project/assets/scene-02.png"
  },
  {
    "id": 3,
    "start": 10.25,
    "end": 15.0,
    "text": "A bogeyman who carries children away when they misbehave.",
    "image": "project/assets/scene-03.png"
  },
  {
    "id": 4,
    "start": 15.0,
    "end": 19.0,
    "text": "Three sacks. Nine straps. Twelve eyes.",
    "image": "project/assets/scene-04.png"
  },
  {
    "id": 5,
    "start": 19.0,
    "end": 23.958333333333332,
    "text": "Now imagine this fictional version. You wake up alone.",
    "image": "project/assets/scene-05.png"
  },
  {
    "id": 6,
    "start": 23.958333333333332,
    "end": 29.416666666666664,
    "text": "There's breathing outside your bedroom. Then someone whispers your name.",
    "image": "project/assets/scene-06.png"
  },
  {
    "id": 7,
    "start": 29.416666666666664,
    "end": 34.291666666666664,
    "text": "Your grandmother's warning comes back. Don't answer him.",
    "image": "project/assets/scene-07.png"
  },
  {
    "id": 8,
    "start": 34.291666666666664,
    "end": 38.08333333333333,
    "text": "And whatever you hear, don't open the sack.",
    "image": "project/assets/scene-08.png"
  },
  {
    "id": 9,
    "start": 38.08333333333333,
    "end": 41.70833333333333,
    "text": "You stay silent. You leave it hanging.",
    "image": "project/assets/scene-09.png"
  },
  {
    "id": 10,
    "start": 41.70833333333333,
    "end": 45.49999999999999,
    "text": "The breathing stops. You think he's gone.",
    "image": "project/assets/scene-10.png"
  },
  {
    "id": 11,
    "start": 45.49999999999999,
    "end": 49.99999999999999,
    "text": "Then it starts again. This time, beneath your bed.",
    "image": "project/assets/scene-11.png"
  },
  {
    "id": 12,
    "start": 49.99999999999999,
    "end": 54.79166666666666,
    "text": "You lift the covers. Something tightens around the mattress.",
    "image": "project/assets/scene-12.png"
  },
  {
    "id": 13,
    "start": 54.79166666666666,
    "end": 59.04166666666666,
    "text": "The sack outside was never meant to catch you.",
    "image": "project/assets/scene-13.png"
  },
  {
    "id": 14,
    "start": 59.04166666666666,
    "end": 62.70833333333332,
    "text": "It was there to keep your eyes on the door.",
    "image": "project/assets/scene-14.png"
  },
  {
    "id": 15,
    "start": 62.70833333333332,
    "end": 68.12499999999999,
    "text": "An arm slides out from under your bed, pulling up another sack.",
    "image": "project/assets/scene-15.png"
  },
  {
    "id": 16,
    "start": 68.12499999999999,
    "end": 74.08333333333331,
    "text": "You followed both rules. You just never checked where you were sleeping.",
    "image": "project/assets/scene-16.png"
  }
]